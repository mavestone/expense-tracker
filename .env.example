# ── Database ──────────────────────────────────────────────────────────────
# Local / self-hosted: a plain SQLite file (created automatically).
DATABASE_URL=file:./data/app.db
# On Vercel with Turso: DATABASE_URL=libsql://<your-db>.turso.io
# DATABASE_AUTH_TOKEN=<turso auth token>

# ── Receipt file storage ──────────────────────────────────────────────────
# "local" stores receipt files under DATA_DIR/receipts (default for self-hosting).
# "vercel-blob" stores them in Vercel Blob (requires BLOB_READ_WRITE_TOKEN).
STORAGE_DRIVER=local
DATA_DIR=./data
# BLOB_READ_WRITE_TOKEN=<from Vercel Blob store>

# ── Auth (single user) ────────────────────────────────────────────────────
# Generate a hash with: npm run hash-password  (preferred over plain password)
# APP_PASSWORD_HASH=scrypt$...
APP_PASSWORD=change-me
# 32+ random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-secret-please-change-0000000000

# ── Misc ──────────────────────────────────────────────────────────────────
# Timezone used for "today" in renewal generation and staleness checks.
APP_TIMEZONE=Australia/Sydney
# Protects /api/cron/renewals when using Vercel Cron.
# CRON_SECRET=<random string>

# ── Agent ingestion API (optional) ────────────────────────────────────────
# Enables /api/agent/* so an AI assistant (e.g. a Hyperagent skill) can post
# analysed invoices as expense records. Disabled unless set (16+ chars).
# AGENT_API_KEY=<openssl rand -hex 24>
